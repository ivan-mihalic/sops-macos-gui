      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How your key is protected on this Mac."
          }
        }
      }
    },
    "onboarding.summary.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can re-run these checks any time from Settings › Health. Nothing here blocks you from using the app."
          }
        }
      }
    },
    "onboarding.summary.nothing-checked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was checked, so there is nothing to report yet."
          }
        }
      }
    },
    "onboarding.summary.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything checks out."
          }
        }
      }
    },
    "onboarding.summary.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some things need fixing."
          }
        }
      }
    },
    "onboarding.summary.skipped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some checks don't apply yet."
          }
        }
      }
    },
    "onboarding.summary.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's everything."
          }
        }
