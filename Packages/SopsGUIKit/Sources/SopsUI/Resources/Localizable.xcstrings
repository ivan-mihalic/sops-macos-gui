    "settings.updates.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is on, the health check asks GitHub for the latest sops and age releases and compares them against the versions built into this app. It is a version comparison, not a vulnerability scan — this app never claims to know whether a version is safe."
          }
        }
      }
    },
    "settings.updates.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only network request this app makes on its own. It sends no identifier for you or this Mac, and it is off until you turn it on. The health check separately runs your login shell to find your command-line tools, then each tool to read its version — including sops, which it explicitly tells not to check GitHub for a newer sops."
          }
        }
      }
    },
    "settings.updates.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for engine updates"
          }
        }
      }
    },
