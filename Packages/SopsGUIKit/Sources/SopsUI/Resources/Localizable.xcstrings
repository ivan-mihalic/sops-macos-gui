    "key.import.legacy-footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only reads that file when you press the button above — never automatically."
          }
        }
      }
    },
    "key.import.legacy-success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported for this session. That file is still sitting on disk unprotected — this app can't import it out of harm's way, but you can narrow who can read it:"
          }
        }
      }
    },
    "key.import.paste-button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
