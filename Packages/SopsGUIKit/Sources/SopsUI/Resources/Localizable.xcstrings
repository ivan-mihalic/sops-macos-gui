    "settings.scanning.budget-footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A very large project can exhaust this limit before every file has been examined; its findings then read as unknown rather than a false all-clear. Raise the limit if a scan is being truncated; lower it only if scanning itself feels slow."
          }
        }
      }
    },
    "settings.scanning.budget-label": {
      "extractionState": "manual",
      "localizations": {
