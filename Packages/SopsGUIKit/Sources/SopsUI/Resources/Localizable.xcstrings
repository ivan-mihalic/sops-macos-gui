    "key.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's empty. Paste your age key — it starts with AGE-SECRET-KEY-1."
          }
        }
      }
    },
    "key.error.multiple-keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file has %d keys in it. This app can only hold one at a time — trim the file to the one you want, or paste it directly instead."
          }
        }
      }
    },
    "key.error.not-an-age-key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like an age key. An age private key starts with AGE-SECRET-KEY-1."
          }
        }
      }
    },
    "key.error.read-failed": {
      "extractionState": "manual",
      "localizations": {
