      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next few screens check your machine anyway, because the snippets in Help run in your terminal and in CI, against the same files."
          }
        }
      }
    },
    "onboarding.welcome.body3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here is installed or changed for you. Where something needs fixing, you get the command and run it yourself."
