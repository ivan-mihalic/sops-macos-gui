      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some checks couldn't reach a verdict."
          }
        }
      }
    },
    "onboarding.summary.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some things are worth a look."
          }
        }
      }
    },
    "onboarding.tools.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional, but the Help snippets rely on them."
          }
        }
      }
    },
    "onboarding.welcome.body1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app encrypts and decrypts your secrets itself — no command-line tools required."
          }
        }
      }
    },
    "onboarding.welcome.body2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next few screens check your machine anyway, because the snippets in Help run in your terminal and in CI, against the same files."
          }
        }
      }
    },
    "onboarding.welcome.body3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here is installed or changed for you. Where something needs fixing, you get the command and run it yourself."
          }
        }
      }
    },
    "onboarding.welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick look at how this machine is set up."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        }
      }
    },
