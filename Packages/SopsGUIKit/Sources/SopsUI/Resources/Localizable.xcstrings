    "access.duplicate-recipients": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This file's SOPS metadata lists %d recipient more than once. Listing a key twice grants no extra access, so it appears once above. Applying any change here writes each key exactly once."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This file's SOPS metadata lists %d recipients more than once. Listing a key twice grants no extra access, so each appears once above. Applying any change here writes each key exactly once."
                }
              }
            }
          }
        }
      }
