    "onboarding.engine.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sops and age versions built into this app."
          }
        }
      }
    },
    "onboarding.projects.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your .sops.yaml files and encrypted secrets."
          }
        }
      }
    },
