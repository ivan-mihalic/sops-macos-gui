    "access.rewrap.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is encrypted for %2$@, its rule wants %3$@."
          }
        }
      }
    },
    "access.rewrap.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same thing sops updatekeys does. Needs your private key. A removed recipient keeps what it already read."
          }
        }
      }
    },
    "access.rewrap.rule-not-staged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule was left alone: its recipients could not be staged exactly as it declares them, and a partial set is worse than none."
          }
        }
      }
    },
