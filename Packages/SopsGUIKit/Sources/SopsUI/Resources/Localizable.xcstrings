    "settings.tab.updates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "settings.updates.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is on, this app asks GitHub for the latest sops and age releases and compares them against the versions built into it, and it looks once a day for a newer version of the app itself. Both are version comparisons, not vulnerability scans — this app never claims to know whether a version is safe. Nothing is ever downloaded or installed without you pressing Install first."
          }
        }
      }
    },
    "settings.updates.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the only network requests this app makes on its own. They send no identifier for you or this Mac, and they are off until you turn them on — you can still check for an app update by hand at any time from the app menu. The health check separately runs your login shell to find your command-line tools, then each tool to read its version — including sops, which it explicitly tells not to check GitHub for a newer sops."
          }
        }
      }
    },
    "settings.updates.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates"
          }
        }
      }
    },
