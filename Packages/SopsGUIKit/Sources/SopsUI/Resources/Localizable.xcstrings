        }
      }
    },
    "key.paste.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held in memory for this session only. Never written to disk, and forgotten when you quit the app or press Forget."
          }
        }
      }
    },
    "key.paste.header": {
      "extractionState": "manual",
      "localizations": {
